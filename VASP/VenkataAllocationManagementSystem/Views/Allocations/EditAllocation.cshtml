@using (Html.BeginForm("EditAllocation", "Allocations", FormMethod.Post))
{
    <input type="hidden" asp-for="@Model.AllocationsInfo[0].AllocationId" />
    <input type="hidden" asp-for="@Model.AllocationsInfo[0].AssociateId" />
    <input type="hidden" asp-for="@Model.AllocationsInfo[0].ProjectId" />
    <input type="hidden" asp-for="@Model.AllocationsInfo[0].IsActive" />
    <input type="hidden" asp-for="@Model.ProjectEndDate" id="ProjectEndDate" />
    <input type="hidden" asp-for="@Model.ProjectStartDate" id="ProjectStartDate" />

    <fieldset>
     <legend>Associate, Account & Project Details</legend>
    <div class="row">
        <div class="col-md-6"> 
            <div class="form-group">
                <label asp-for="AssociateName" class="control-label">Associate Name</label>
                <input asp-for="@Model.AssociateName" class="form-control" readonly type="text" />
            </div>       
            <div class="form-group">
                <label asp-for="AccountName" class="control-label">Account Name</label>
                <input asp-for="@Model.AccountName" class="form-control" readonly type="text" />
            </div>       
            <div class="form-group">
