                <span asp-validation-for="BillabilityTypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AllocationPercentage" class="control-label">Allocation Percentage</label>
                <input asp-for="@Model.AllocationsInfo[0].AllocationPercentage" class="form-control" type="number" step="0.01" min="0" max="100" />
                <span asp-validation-for="AllocationPercentage" class="text-danger"></span>
            </div>
            
        </div>
    </div>
</fieldset>
