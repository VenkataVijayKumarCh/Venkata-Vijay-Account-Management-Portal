    <div class="form-group">
                <button type="button" class="btn btn-success" onclick="addRow()">Add Row</button>
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="AllocationManagement" class="btn btn-secondary">Cancel</a>        
    </div>


<script>
    function getCurrentRowCount() {
        var table = document.getElementById("allocationRateGrid");
        return table.getElementsByTagName('tbody')[0].getElementsByTagName('tr').length;
    }

    function addRow() {
        var table = document.getElementById("allocationRateGrid").getElementsByTagName('tbody')[0];
        var rowIndex = getCurrentRowCount(); // Get current number of rows
        var newRow = table.insertRow();
        newRow.innerHTML = `
            <td>
                <input type="date" name="AllocationRates[${rowIndex}].AllocationRateStartDate" 
                    class="form-control datepicker" />
            </td>
            <td>
                <input type="date" name="AllocationRates[${rowIndex}].AllocationRateEndDate" 
                    class="form-control datepicker" />
            </td>
            <td>
                <input type="number" name="AllocationRates[${rowIndex}].AllocationBillRate" 
                    class="form-control" step="0.01" min="0" />
            </td>
            <td style="text-align:center;">
                <button type="button" class="btn btn-danger" onclick="deleteRow(this)">Delete</button>
            </td>
        `;
    }

    function deleteRow(btn) {
        var row = btn.closest('tr');
        row.parentNode.removeChild(row);
        reindexRows(); // Reindex remaining rows after deletion
    }

    function reindexRows() {
        var table = document.getElementById("allocationRateGrid");
        var rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');
        
        for(var i = 0; i < rows.length; i++) {
            var inputs = rows[i].getElementsByTagName('input');
            for(var j = 0; j < inputs.length; j++) {
                var input = inputs[j];
                var name = input.getAttribute('name');
                if(name) {
                    // Replace the index in the name attribute
                    input.setAttribute('name', name.replace(/\[\d+\]/, `[${i}]`));
                }
            }
        }
    }
</script>

