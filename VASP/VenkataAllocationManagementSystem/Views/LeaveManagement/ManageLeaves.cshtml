@using VenkataAllocationManagementSystem.ViewModels;

@{
    ViewData["Title"] = "Leave Management";
}

@model LeaveManagementViewModel

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2 class="mb-4">
                <i class="bi bi-calendar-event"></i> Leave Management
            </h2>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Add/Edit Leave Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Record Leave Request</h5>
        </div>
        <div class="card-body">
            <form asp-action="CreateLeave" method="post">
                @Html.AntiForgeryToken()

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label" for="LeaveRequest.AssociateId">Associate Name <span class="text-danger">*</span></label>
                        <select class="form-control form-control-sm" id="LeaveRequest.AssociateId" name="LeaveRequest.AssociateId" required>
                            <option value="">-- Select Associate --</option>
                            @if (Model.Associates != null)
                            {
                                @foreach (var associate in Model.Associates)
                                {
                                    <option value="@associate.AssociateId">@associate.FullName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="LeaveRequest.AssociateId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="LeaveRequest.LeaveType">Leave Type <span class="text-danger">*</span></label>
                        <select class="form-control form-control-sm" id="LeaveRequest.LeaveType" name="LeaveRequest.LeaveType" required>
                            <option value="Annual">Annual Leave</option>
                            <option value="Sick">Sick Leave</option>
                            <option value="Casual">Casual Leave</option>
                            <option value="Maternity">Maternity Leave</option>
                            <option value="Paternity">Paternity Leave</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="LeaveRequest.LeaveType" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label" for="LeaveRequest.StartDate">Start Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control form-control-sm" id="LeaveRequest.StartDate" name="LeaveRequest.StartDate" 
                               value="@Model.LeaveRequest?.StartDate.ToString("yyyy-MM-dd")" required onchange="calculateDays()">
                        <span asp-validation-for="LeaveRequest.StartDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="LeaveRequest.EndDate">End Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control form-control-sm" id="LeaveRequest.EndDate" name="LeaveRequest.EndDate" 
                               value="@Model.LeaveRequest?.EndDate.ToString("yyyy-MM-dd")" required onchange="calculateDays()">
                        <span asp-validation-for="LeaveRequest.EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label" for="LeaveRequest.RequestedDays">Number of Days <span class="text-danger">*</span></label>
                        <div class="input-group input-group-sm">
                            <input type="number" step="0.5" min="0.5" max="365" class="form-control" id="LeaveRequest.RequestedDays" 
                                   name="LeaveRequest.RequestedDays" value="@Model.LeaveRequest?.RequestedDays" required>
                            <button class="btn btn-outline-secondary" type="button" onclick="autoCalculateDays()" title="Auto-calculate days excluding weekends and holidays">
                                Auto-Calculate
                            </button>
                        </div>
                        <small class="form-text text-muted">Use 0.5 for half-day, or modify manually as needed</small>
                        <span asp-validation-for="LeaveRequest.RequestedDays" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="LeaveRequest.Status">Status <span class="text-danger">*</span></label>
                        <select class="form-control form-control-sm" id="LeaveRequest.Status" name="LeaveRequest.Status" required>
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                        </select>
                        <span asp-validation-for="LeaveRequest.Status" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="LeaveRequest.Notes">Notes</label>
                    <textarea class="form-control form-control-sm" id="LeaveRequest.Notes" name="LeaveRequest.Notes" rows="2" placeholder="Optional notes"></textarea>
                    <span asp-validation-for="LeaveRequest.Notes" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="bi bi-check-circle"></i> Save Leave Request
                    </button>
                    <a href="@Url.Action("ManageLeaves")" class="btn btn-secondary btn-sm">
                        <i class="bi bi-x-circle"></i> Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Leave Requests List -->
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Leave Requests History</h5>
        </div>
        <div class="card-body">
            @if (Model.LeaveRequests != null && Model.LeaveRequests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Associate</th>
                                <th>Leave Type</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Days</th>
                                <th>Status</th>
                                <th>Requested On</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leave in Model.LeaveRequests)
                            {
                                <tr>
                                    <td>@leave.Associate?.FullName</td>
                                    <td>
                                        <span class="badge bg-secondary">@leave.LeaveType</span>
                                    </td>
                                    <td>@leave.StartDate.ToString("dd MMM yyyy")</td>
                                    <td>@leave.EndDate.ToString("dd MMM yyyy")</td>
                                    <td class="fw-bold">@leave.RequestedDays</td>
                                    <td>
                                        @if (leave.Status == LeaveStatuses.Approved.ToString()) // "Approved"
                                        {
                                            <span class="badge bg-success">@leave.Status</span>
                                        }
                                        else if (leave.Status == LeaveStatuses.Rejected.ToString()) // "Rejected"
                                        {
                                            <span class="badge bg-danger">@leave.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">@leave.Status</span>
                                        }
                                    </td>
                                    <td>@leave.RequestedOn.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (leave.Status == LeaveStatuses.Pending.ToString())
                                        {
                                            <form method="post" action="@Url.Action("SubmitLeave")" style="display:inline;" 
                                                  onsubmit="return confirm('Are you sure you want to submit this leave request for approval?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@leave.LeaveRequestId" />
                                                <button type="submit" class="btn btn-sm btn-info" title="Submit for Approval">
                                                    <i class="bi bi-arrow-up-circle"></i> Submit
                                                </button>
                                            </form>
                                            <a href="@Url.Action("EditLeave", new { id = leave.LeaveRequestId })" class="btn btn-sm btn-primary" title="Edit">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <form method="post" action="@Url.Action("DeleteLeave")" style="display:inline;" 
                                                  onsubmit="return confirm('Are you sure you want to delete this leave request?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@leave.LeaveRequestId" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </form>
                                        }
                                        else if (leave.Status == LeaveStatuses.Submitted.ToString())
                                        {
                                            <form method="post" action="@Url.Action("ApproveLeave")" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@leave.LeaveRequestId" />
                                                <button type="submit" class="btn btn-sm btn-success" title="Approve Leave">
                                                    <i class="bi bi-check-circle"></i> Approve
                                                </button>
                                            </form>
                                            <a href="@Url.Action("EditLeave", new { id = leave.LeaveRequestId })" class="btn btn-sm btn-primary" title="Edit">
                                                <i class="bi bi-pencil"></i> View
                                            </a>
                                            <form method="post" action="@Url.Action("RejectLeave")" style="display:inline;" 
                                                  onsubmit="return confirm('Are you sure you want to reject this leave request?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@leave.LeaveRequestId" />
                                                <button type="submit" class="btn btn-sm btn-warning" title="Reject Leave">
                                                    <i class="bi bi-x-circle"></i> Reject
                                                </button>
                                            </form>
                                        }
                                        else if (leave.Status == LeaveStatuses.Approved.ToString() || leave.Status == LeaveStatuses.Rejected.ToString())
                                        {
                                            <a href="@Url.Action("EditLeave", new { id = leave.LeaveRequestId })" class="btn btn-sm btn-primary" title="Edit">
                                                <i class="bi bi-pencil"></i> View
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    No leave requests found.
                </div>
            }
        </div>
    </div>
</div>

<script>
    function calculateDays() {
        const startInput = document.getElementById('LeaveRequest.StartDate').value;
        const endInput = document.getElementById('LeaveRequest.EndDate').value;

        if (startInput && endInput) {
            const startDate = new Date(startInput);
            const endDate = new Date(endInput);

            if (endDate >= startDate) {
                const timeDiff = endDate - startDate;
                const daysDiff = Math.ceil(timeDiff / (1000 * 60 * 60 * 24)) + 1; // +1 to include both start and end date
                document.getElementById('LeaveRequest.RequestedDays').value = daysDiff;
            }
        }
    }

    function autoCalculateDays() {
        calculateDays();
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
