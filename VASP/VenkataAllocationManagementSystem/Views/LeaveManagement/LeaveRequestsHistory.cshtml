@using VenkataAllocationManagementSystem.ViewModels;

@{
    ViewData["Title"] = "Leave Requests History";
}

@model LeaveManagementViewModel

<div>
       
</div>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2 class="mb-4">
                <i class="bi bi-calendar-event"></i> Leave Requests History 
            </h2>
        </div>
    </div>

    <!-- Project & Associate Selection and Load Button -->
    <section>
        <form method="post" asp-action="LeaveRequestsHistory">
            @Html.AntiForgeryToken()
            <div class="d-flex align-items-center gap-3 mb-4">
                <label for="Search" class="form-label mb-0" style="font-weight:bold">Search</label>
                @* <div class="input-group"> *@
                    @if (Model.Projects != null && Model.Projects.Any())
                    {
                        @Html.DropDownListFor(p => p.ProjectId, 
                            new SelectList(Model.Projects, "ProjectId", "ProjectName"),
                            "-- Select Project --",
                            htmlAttributes: new { @class = "form-control", id = "ProjectId", style = "width: 250px;" })                
                    }
                    else
                    {
                        <span class="text-danger">No Projects available. Please create the Project first.</span>
                    }                
                    @if (Model.Associates != null && Model.Associates.Any())
                    {
                        @Html.DropDownListFor(p => p.AssociateId, 
                            new SelectList(Model.Associates, "AssociateId", "FullName"),
                            "-- Select Associate --",
                            htmlAttributes: new { @class = "form-control", id = "AssociateId", style = "width: 250px;" })                
                    }
                    else
                    {
                        <span class="text-danger">No Associates available. Please create an associate first.</span>
                    }
                     @if (Model.MonthList != null && Model.MonthList.Any())
                    {
                        @Html.DropDownListFor(p => p.SelectedMonth, 
                            new SelectList(Model.MonthList, "Value", "Text"),
                            "-- Select Month --",
                            htmlAttributes: new { @class = "form-control", id = "keyMonth", style = "width: 250px;" })                
                    }
                    else
                    {
                        <span class="text-danger">No Months available. Please create a month first.</span>
                    }
                    <button type="submit" class="btn btn-primary" id="btnLoadLeaveRequestsHistory" name="action" value="load" style="width: 250px;">
                        Load Leave Requests
                    </button>
                @* </div> *@
            </div>
        </form>
    </section>


    



    <!-- Leave Requests List -->
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Leave Requests History (Associates : @Model.LeaveRequests!.DistinctBy(lr => lr.AssociateId).Count() & Number of Leaves (in Days): @Model.LeaveRequests!.Sum(lr => lr.RequestedDays))</h5>
        </div>        
        <div class="card-body">
            @if (Model.LeaveRequests != null && Model.LeaveRequests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Associate</th>
                                <th>Leave Type</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Days</th>
                                <th>Status</th>
                                <th>Requested On</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var leave in Model.LeaveRequests)
                            {
                                <tr>
                                    <td style="vertical-align: middle;">@leave.Associate?.FullName</td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span class="badge bg-secondary">@leave.LeaveType</span>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">@leave.StartDate.ToString("dd MMM yyyy")</td>
                                    <td style="text-align: center; vertical-align: middle;">@leave.EndDate.ToString("dd MMM yyyy")</td>
                                    <td style="text-align: center; vertical-align: middle;" class="fw-bold">@leave.RequestedDays</td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        @if (leave.Status == LeaveStatuses.Approved.ToString()) // "Approved"
                                        {
                                            <span class="badge bg-success">@leave.Status</span>
                                        }
                                        else if (leave.Status == LeaveStatuses.Rejected.ToString()) // "Rejected"
                                        {
                                            <span class="badge bg-danger">@leave.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">@leave.Status</span>
                                        }
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">@leave.RequestedOn.ToString("dd MMM yyyy")</td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        @if (leave.Status == LeaveStatuses.Pending.ToString())
                                        {
                                            <form method="post" action="@Url.Action("SubmitLeave")" style="display:inline;" 
                                                  onsubmit="return confirm('Are you sure you want to submit this leave request for approval?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@leave.LeaveRequestId" />
                                                <button type="submit" class="btn btn-sm btn-info" title="Submit for Approval">
                                                    <i class="bi bi-arrow-up-circle"></i> Submit
                                                </button>
                                            </form>
                                            <a href="@Url.Action("EditLeave", new { id = leave.LeaveRequestId })" class="btn btn-sm btn-primary" title="Edit">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <form method="post" action="@Url.Action("DeleteLeave")" style="display:inline;" 
                                                  onsubmit="return confirm('Are you sure you want to delete this leave request?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@leave.LeaveRequestId" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </form>
                                        }
                                        else if (leave.Status == LeaveStatuses.Submitted.ToString())
                                        {
                                            <form method="post" action="@Url.Action("ApproveLeave")" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@leave.LeaveRequestId" />
                                                <button type="submit" class="btn btn-sm btn-success" title="Approve Leave">
                                                    <i class="bi bi-check-circle"></i> Approve
                                                </button>
                                            </form>
                                            <a href="@Url.Action("EditLeave", new { id = leave.LeaveRequestId })" class="btn btn-sm btn-primary" title="Edit">
                                                <i class="bi bi-pencil"></i> View
                                            </a>
                                            <form method="post" action="@Url.Action("RejectLeave")" style="display:inline;" 
                                                  onsubmit="return confirm('Are you sure you want to reject this leave request?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@leave.LeaveRequestId" />
                                                <button type="submit" class="btn btn-sm btn-warning" title="Reject Leave">
                                                    <i class="bi bi-x-circle"></i> Reject
                                                </button>
                                            </form>
                                        }
                                        else if (leave.Status == LeaveStatuses.Approved.ToString() || leave.Status == LeaveStatuses.Rejected.ToString())
                                        {
                                            <a href="@Url.Action("EditLeave", new { id = leave.LeaveRequestId })" class="btn btn-sm btn-primary" title="Edit">
                                                <i class="bi bi-pencil"></i> View
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    No leave requests found.
                </div>
            }
        </div>
    </div>
</div>