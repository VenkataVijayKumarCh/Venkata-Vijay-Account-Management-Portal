<section> 
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Accounts</h5>
                    <p class="card-text display-6">
                        <a asp-action="AccountManagement" asp-controller="Accounts" class="btn btn-primary">
                            @if (@Model.Accounts == null)
                            {
                                <span>0</span>
                            }
                            else
                            {
                                <span>@Model.Accounts.Count</span>
                            }
                        </a>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Projects</h5>
                    <p class="card-text display-6">
                        <a asp-action="ProjectManagement" asp-controller="Projects" class="btn btn-primary">
                            @if (@Model.Projects == null)
                            {
                                <span>0</span>
                            }
                            else
                            {
                                <span>@Model.Projects.Count</span>
                            }
                        </a>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Associates</h5>
                    <p class="card-text display-6">
                        <a asp-action="AssociateManagement" asp-controller="Associates" class="btn btn-primary">
                            @if (@Model.Associates == null)
                            {
                                <span>0</span>
                            }
                            else
                            {
                                <span>@Model.Associates.Count</span>
                            }
                        </a>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Allocations</h5>
                    <p class="card-text display-6">
                        <a asp-action="AllocationManagement" asp-controller="Allocations" class="btn btn-primary">
                            @if (@Model.Allocations == null)
                            {
                                <span>0</span>
                            }
                            else
                            {
                                <span>@Model.Allocations.Count</span>
                            }
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Timesheets</h5>
                    <p class="card-text display-6">
                        @* <a asp-action="TimesheetManagement" asp-controller="Timesheets" class="btn btn-primary"> *@
                        <a asp-action="ViewMyTimesheets" asp-controller="Timesheets" class="btn btn-primary">
                            @if (@Model.Timesheets == null)
                            {
                                <span>No Timesheets</span>
                            }
                            else
                            {
                                <span>@Model.Timesheets.Count</span>
                            }
                        </a>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Total Hours Logged</h5>
                    <p class="card-text display-6">
                        @* <a asp-action="TimesheetManagement" asp-controller="Timesheets" class="btn btn-primary"> *@
                        <a asp-action="ViewMyTimesheets" asp-controller="Timesheets" class="btn btn-primary">
                            @if (@Model.Timesheets == null)
                            {
                                <span>No Timesheets</span>
                            }
                            else
                            {
                                decimal totalHours = 0;
                                @foreach(Timesheet ts in Model.Timesheets)
                                {
                                    totalHours += (decimal)ts.TotalHours!;
                                }
                                <span>@totalHours</span>
                            }
                        </a>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Total Approved Hours</h5>
                    <p class="card-text display-6">
                        @* <a asp-action="TimesheetManagement" asp-controller="Timesheets" class="btn btn-primary"> *@
                        <a asp-action="ViewMyTimesheets" asp-controller="Timesheets" class="btn btn-primary">
                            @if (@Model.Timesheets == null)
                            {
                                <span>No Timesheets</span>
                            }
                            else
                            {
                                decimal totalHours = 0;
                                @foreach(Timesheet ts in Model.Timesheets)
                                {
                                    if (ts.Status == "Approved")
                                        totalHours += (decimal)ts.TotalHours!;
                                }
                                <span>@totalHours</span>
                            }
                        </a>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Total Rejected Hours</h5>
                    <p class="card-text display-6">
                        @* <a asp-action="TimesheetManagement" asp-controller="Timesheets" class="btn btn-primary"> *@
                        <a asp-action="ViewMyTimesheets" asp-controller="Timesheets" class="btn btn-primary">
                            @if (@Model.Timesheets == null)
                            {
                                <span>No Timesheets</span>
                            }
                            else
                            {
                                decimal totalHours = 0;
                                @foreach(Timesheet ts in Model.Timesheets)
                                {
                                    if (ts.Status == "Rejected")
                                        totalHours += (decimal)ts.TotalHours!;
                                }
                                <span>@totalHours</span>
                            }
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Revenue Generated</h5>
                    <p class="card-text display-6">
                        @* <a asp-action="TimesheetManagement" asp-controller="Timesheets" class="btn btn-primary"> *@
                        <a asp-action="PortfolioDashboard" asp-controller="Portfolio" class="btn btn-primary">
                            @if (@Model.Timesheets == null)
                            {
                                <span>No Revenue Generated</span>
                            }
                            else
                            {
                                <span>@Model.RevenueGenerated.ToString("C")</span>
                            }
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

