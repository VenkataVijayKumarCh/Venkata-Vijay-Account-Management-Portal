@model VenkataAllocationManagementSystem.ViewModels.TimesheetsViewModel

@if (Model == null || !Model.TimesheetLineItems!.Any())
{
    <div class="alert alert-info">No timesheet lines to display. Please select a Timesheet Period and Project.</div>
}
else
{
    @Html.HiddenFor(m => m.TimesheetStartDate)
    @Html.HiddenFor(m => m.TimesheetEndDate)

    <table class="table table-bordered">
        <thead>            
            <tr>
                <th>Billability</th>
                @for (int index = 0; index < Model.TimesheetLineItems!.Count; index++)
                {
                    <th>
                        @Model.TimesheetLineItems[index].WorkDate.DayOfWeek.ToString()
                    </th>
                }
                <th>Total Hours</th>
            </tr>
            <tr>
                <th></th>
                @for (int index = 0; index < Model.TimesheetLineItems!.Count; index++)
                {
                    
                    <th>
                        @Html.HiddenFor(m => m.TimesheetLineItems![index].WorkDate)
                        @Model.TimesheetLineItems[index].WorkDate.ToShortDateString()
                    </th>
                }
                <th>Total Hours</th>
            </tr>
        </thead>
        <tbody>                  
            <tr>
                <td style="align:center;">     
                    @if (Model.IsEditMode)
                    {
                        @Html.DropDownListFor(m => m.TimesheetsInfo![0].BillabilityTypeId,
                                new SelectList(Model.BillabilityTypes, "BillabilityTypeId", "BillabilityTypeName",
                                    Model.TimesheetsInfo[0].BillabilityTypeId),
                                "Select Billability", new { @class = "form-control", @id = "ddlBillability" })
                        @Html.ValidationMessageFor(m => m.TimesheetsInfo![0].BillabilityTypeId)
                    }
                    else
                    {
                        @Html.DropDownListFor(m => m.AssociateTimesheetRows![0].BillabilityTypeId,
                                new SelectList(Model.BillabilityTypes, "BillabilityTypeId", "BillabilityTypeName",
                                    Model.AssociateTimesheetRows![0].BillabilityTypeId),
                                "Select Billability", new { @class = "form-control", @id = "ddlBillability" })
                        @Html.ValidationMessageFor(m => m.AssociateTimesheetRows![0].BillabilityTypeId)
                    }
                </td>
                    
                
                @for (int index = 0; index < Model.TimesheetLineItems!.Count; index++)
                {
                    @if (Model.IsEditMode)
                    {
                        @Html.HiddenFor(m => m.TimesheetLineItems![index].TimesheetLineItemId)
                    }
                    @Html.HiddenFor(m => m.TimesheetLineItems![index].WorkDate)
                    <td>
                        @Html.TextBoxFor(m => m.TimesheetLineItems![index].EntryValue, new { @class = "form-control", type = "text", inputmode = "decimal", placeholder = "Hours, H or L" })
                        @Html.ValidationMessageFor(m => m.TimesheetLineItems![index].HoursWorked)
                    </td>                    
                }
                <td>
                    @Html.TextBoxFor(m => m.TotalHours, new { @class = "form-control", id = "totalHours", type = "number", step = "0.25", min = "0", max = "63", @readonly = "readonly" })
                    @Html.ValidationMessageFor(m => m.TotalHours)
                </td>
            </tr>
            <tr>
                <td colspan="9">
                    @if (Model.IsEditMode)
                    {
                        @Html.TextBoxFor(m => m.TimesheetLineItems![0].Description, new { @class = "form-control", placeholder = "Enter Description" })
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.Description, new { @class = "form-control", placeholder = "Enter Description" })
                    }                    
                    @Html.ValidationMessageFor(m => m.Description)
                </td>
            </tr>
        </tbody>
    </table>
    <div class="form-group" style="padding:5px 0px 5px 0px;">
        @if (Model.IsEditMode)
        {
            <button type="submit" class="btn btn-primary" name="action" value="updatets">Update Timesheet</button>
        }
        else
        {
            <button type="submit" class="btn btn-primary" name="action" value="submitmyts">Submit Timesheet</button>
        }
        @* <a asp-action="ViewTimesheets" asp-controller="Timesheets" class="btn btn-secondary">Cancel</a> *@
        <a class="btn btn-secondary" onclick="handleCancel()" no-formaction="true">Cancel</a>
    </div>
}
@section Scripts {
    @* <script>
        function updateTotalHours() {
            let total = 0;
            document.querySelectorAll('input[name$=".HoursWorked"]').forEach(function(input) {
                let val = parseFloat(input.value);
                if (!isNaN(val)) total += val;
            });
            // document.getElementById('totalHours').textContent = total;
            document.getElementById('totalHours').value = total;
        }

        document.addEventListener("DOMContentLoaded", function () {
            updateTotalHours();
            document.querySelectorAll('input[name$=".HoursWorked"]').forEach(function(input) {
                input.addEventListener('input', updateTotalHours);
            });
        });
    </script> *@    
}