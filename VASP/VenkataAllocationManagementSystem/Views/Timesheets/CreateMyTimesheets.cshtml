    <script>
        function handleCancel() {            
            const referrer = document.referrer;
            if (referrer.includes("ViewTeamMemberTimesheets")) {
                window.location.href = '@Url.Action("ViewTeamMemberTimesheets", "Timesheets")';
            }
            else if (referrer.includes("CreateMyTimesheets")) {
                window.location.href = '@Url.Action("ViewMyTimesheets", "Timesheets")';
            } 
            else if (referrer.includes("CreateMultipleTimesheets")) {
                window.location.href = '@Url.Action("ViewTeamMemberTimesheets", "Timesheets")';
            } 
            else {
                window.location.href = '@Url.Action("ViewMyTimesheets", "Timesheets")';
            }
        }
    </script>

}
