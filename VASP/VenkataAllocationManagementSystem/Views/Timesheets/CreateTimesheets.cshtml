@model VenkataAllocationManagementSystem.ViewModels.TimesheetsViewModel

@{
    ViewBag.Title = "Create Timesheet";
}

<h2>Create Timesheet</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.TimesheetPeriodId)
    @Html.HiddenFor(m => m.TimesheetStartDate)
    @Html.HiddenFor(m => m.TimesheetEndDate)

    <div class="form-group">
        @Html.LabelFor(m => m.ProjectId, "Select the Project")
        @Html.DropDownListFor(m => m.ProjectId, 
                        new SelectList(@Model.Projects, "ProjectId", "ProjectName"), 
                        optionLabel: "Select Project", 
                        htmlAttributes: new { @class = "form-control", id = "ProjectId" })
        @Html.ValidationMessageFor(m => m.ProjectId)        
    </div>

    <table class="table table-bordered">
        <thead>
             <tr>
                @for (int i = 0; i < Model.TimesheetLineItems!.Count; i++)
                {
                    <th>
                        @Model.TimesheetLineItems[i].WorkDate.DayOfWeek.ToString()
                    </th>
                }
                <th>Total Hours</th>
            </tr>
            <tr>
                @for (int i = 0; i < Model.TimesheetLineItems!.Count; i++)
                {
                    
                    <th>
                        @Html.HiddenFor(m => m.TimesheetLineItems![i].WorkDate)
                        @Model.TimesheetLineItems[i].WorkDate.ToShortDateString()
                    </th>
                }
                <th>Total Hours</th>
            </tr>
        </thead>
        <tbody>            
            <tr> 
                @for (int i = 0; i < Model.TimesheetLineItems!.Count; i++)
                {
                                    
                    <td>
                        @Html.TextBoxFor(m => m.TimesheetLineItems![i].HoursWorked, new { @value=0, @class = "form-control", type = "number", step = "0.25", min = "0", max = "24" })
                        @Html.ValidationMessageFor(m => m.TimesheetLineItems![i].HoursWorked)
                    </td>                    
                }
                <td>
                    @Html.TextBoxFor(m => m.TotalHours, new { @class = "form-control", id = "totalHours", type = "number", step = "0.25", min = "0", max = "63", @readonly = "readonly" })
                    @Html.ValidationMessageFor(m => m.TotalHours)
                </td>
            </tr>
            <tr>
                <td colspan="8">
                    @Html.TextBoxFor(m => m.Description, new { @class = "form-control", placeholder = "Enter Description" })
                    @Html.ValidationMessageFor(m => m.Description)
                </td>
            </tr>
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Submit Timesheet</button>
    <a asp-action="ViewTimesheets" asp-controller="Timesheets" class="btn btn-secondary">Cancel</a>

    @section Scripts {
    <script>
        function updateTotalHours() {
            let total = 0;
            document.querySelectorAll('input[name$=".HoursWorked"]').forEach(function(input) {
                let val = parseFloat(input.value);
                if (!isNaN(val)) total += val;
            });
            // document.getElementById('totalHours').textContent = total;
            document.getElementById('totalHours').value = total;
        }

        document.addEventListener("DOMContentLoaded", function () {
            updateTotalHours();
            document.querySelectorAll('input[name$=".HoursWorked"]').forEach(function(input) {
                input.addEventListener('input', updateTotalHours);
            });
        });
    </script>    
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
}