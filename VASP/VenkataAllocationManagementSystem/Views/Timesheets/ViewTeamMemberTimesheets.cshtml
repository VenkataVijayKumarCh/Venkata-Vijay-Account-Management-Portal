    <section>
    <h2>Team Member's Timesheets</h2>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Select <input type="checkbox" id="selectAll" /></th>
                <th>Week</th>
                <th>Project</th>
                <th>Associate Name</th>
                <th>Hours Logged</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TimesheetsInfo!.Where(t => t.AssociateId != Model.CurrentAssociateId).Any() == false)
            {
                <tr>
                    <td colspan="7" style="text-align: center; vertical-align: middle;">No Team Timesheets Available.</td>
                </tr>
            }
            else
            {
                @foreach (var ts in Model.TimesheetsInfo!.Where(t => t.AssociateId != Model.CurrentAssociateId))
                {
                    <tr>                        
                        @{
                            // Define the logic: Disable if Status is Approved (2) or Rejected (3)
                            bool isLocked = ts.TimesheetStatus == "Approved" || ts.TimesheetStatus == "Rejected";
                        }

                        <td style="text-align: center; vertical-align: middle;">                        
                            <input type="checkbox" asp-action="BulkApproveTimesheet" asp-route-timesheetId="@ts.TimesheetId" asp-route-origin="ViewTeamMemberTimesheets" 
                            name="selectedTimesheets" value="@ts.TimesheetId" class="form-check-input" @(isLocked ? "disabled" : "")/>
                        </td>
                        <td style="text-align: center; vertical-align: middle;">@ts.TimesheetStartDate.ToShortDateString() - @ts.TimesheetEndDate.ToShortDateString()</td>
                        <td style="text-align: center; vertical-align: middle;">@ts.ProjectName</td> <!-- Replace with project name if available -->
                        <td style="text-align: center; vertical-align: middle;">@ts.AssociateName</td>
                        <td style="text-align: center; vertical-align: middle;">@ts.TotalHours</td>
                        <td style="text-align: center; vertical-align: middle;">@ts.TimesheetStatus</td>
                        <td style="text-align: center;">
                            @{
                                @* var status = @Model.TimesheetsInfo![0].TimesheetStatus;
                                var timesheetId = @Model.TimesheetsInfo![0].TimesheetId; *@
                                var origin = "ViewTeamMemberTimesheets";
                            }
                            @if (ts.TimesheetStatus != "Rejected")
                            {
                                <a asp-action="ViewTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@ts.TimesheetId" asp-route-tsassociateId="@ts.AssociateId" class="btn btn-info btn-sm">View</a>
                            }
                            @if (ts.TimesheetStatus == "Submitted" || ts.TimesheetStatus == "Rejected")
                            {
                                <a asp-action="EditTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@ts.TimesheetId" asp-route-tsassociateId="@ts.AssociateId" class="btn btn-warning btn-sm">Edit</a>                            
                            }
                            @if (ts.TimesheetStatus == "Submitted")
                            {
                                <a asp-action="ApproveTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@ts.TimesheetId" asp-route-origin="@origin" asp-route-tsperiodId="@ts.TimesheetPeriodId" asp-route-tsassociateId="@ts.AssociateId"class="btn btn-warning btn-sm">Approve</a>
                                <a asp-action="RejectTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@ts.TimesheetId" asp-route-origin="@origin" asp-route-tsperiodId="@ts.TimesheetPeriodId" asp-route-tsassociateId="@ts.AssociateId"class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure you want to reject this Timesheet?');">Reject</a>
                            }
                            @if (ts.TimesheetStatus == "Approved")
                            {
                                <a asp-action="ReOpenTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@ts.TimesheetId" asp-route-origin="@origin" asp-route-tsperiodId="@ts.TimesheetPeriodId" asp-route-tsassociateId="@ts.AssociateId"class="btn btn-danger btn-sm"
                                    onclick="return confirm('Are you sure you want to re-open this Timesheet?');">ReOpen</a>
                            } 
                            @if (ts.TimesheetStatus == "ReOpen")
                            {
                                <a asp-action="EditTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@ts.TimesheetId" asp-route-tsassociateId="@ts.AssociateId" class="btn btn-warning btn-sm">Edit</a>
                            }                        
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </section>    
}

@section scripts {
    <script>
        // Select/Deselect all checkboxes which are not disabled
        document.getElementById('selectAll').addEventListener('change', function (e) {
            const checkboxes = document.querySelectorAll('input[name="selectedTimesheets"]:not(:disabled)');
            checkboxes.forEach(cb => cb.checked = e.target.checked);
        });
    </script>
}