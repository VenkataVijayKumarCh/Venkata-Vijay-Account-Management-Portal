            <button type="submit" class="btn btn-primary" id="btnBulkRejectTimesheets" asp-action="BulkRejectTimesheet" asp-controller="Timesheets" asp-route-origin="ViewTeamMemberTimesheets"
                        style="width: 250px;" name="action" value="load">
                Reject Timesheets
            </button>        
        </p>
    </section>

    <section>
        @if(Model.Projects != null && @Model.Projects.Count() != 0)
        {   
            <div class="d-flex align-items-center gap-3 mb-3">
                <label for="ProjectId" class="form-label mb-0" style="font-weight:bold">Search</label>

                @if (Model.Projects != null && Model.Projects.Any())
                {
                    @Html.DropDownListFor(p => p.ProjectId,
                        new SelectList(Model.Projects, "ProjectId", "ProjectName"),
                        "-- Select Project --",
                        htmlAttributes: new { @class = "form-control", id = "ProjectId", style = "width: 250px;" })                
                }
                else
                {
                    <span class="text-danger">No projects available. Please create a project first.</span>
                }
                @if (Model.Associates != null && Model.Associates.Any())
                {
                    @Html.DropDownListFor(p => p.AssociateId,
                        new SelectList(Model.Associates, "AssociateId", "FullName"),
                        "-- Select Associate --",
                        htmlAttributes: new { @class = "form-control", id = "AssociateId", style = "width: 250px;" })                
                }
                @* else
                {
                    <span class="text-danger">No Associates available. Please create an associate first.</span>
                } *@
                @if (Model.TimesheetPeriods != null && Model.TimesheetPeriods.Any())
                {
                    @Html.DropDownListFor(p => p.TimesheetPeriodId,
                        new SelectList(Model.TimesheetPeriods, "TimesheetPeriodId", "WeekStartDate"),
                        "-- Select Timesheet Period --",
                        htmlAttributes: new { @class = "form-control", id = "TimesheetPeriodId", style = "width: 250px;" })
                }
                @if (Model.TimesheetPeriods != null && Model.TimesheetPeriods.Any())
                {
                    @Html.DropDownListFor(p => p.TimesheetStatusId,
                        new SelectList(Model.TimesheetStatuses, "TimesheetStatusId", "TimesheetStatusName"),
                        "-- Select Timesheet Status --",
                        htmlAttributes: new { @class = "form-control", id = "TimesheetStatusId", style = "width: 250px;" })
                }
                <button type="submit" class="btn btn-primary" id="btnLoadTeamMemberTimesheets"
                        style="width: 250px;" name="action" value="load">
                    Load Timesheets
                </button>
            </div>        
            @* <span asp-validation-for="@Model.ProjectId" class="text-danger"></span>
            <span asp-validation-for="@Model.AssociateId" class="text-danger"></span> *@
        }

    </section>

