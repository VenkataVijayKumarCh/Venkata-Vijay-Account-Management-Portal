@model VenkataAllocationManagementSystem.ViewModels.TimesheetsViewModel

@{
    ViewBag.Title = "View Team Memeber's Timesheets";
}
<section>
    <h2>Welcome to the Teams Timesheet Dashboard</h2>
    <p>This dashboard provides an consolidated overview of a particular Team Member's Timesheets.</p>
</section>

<section>
    <h3>Timesheets</h3>
    <p>
        @* <a class="btn btn-primary" asp-controller="Timesheets" asp-action="CreateTimesheets">Create New Timesheet</a> *@
        <a class="btn btn-primary" asp-controller="Timesheets" asp-action="CreateMyTimesheets">Create My New Timesheet</a>
        <a class="btn btn-primary" asp-controller="Timesheets" asp-action="CreateMultipleTimesheets">Create Multiple New Timesheet</a>
        
    </p>
</section>
<section>
@using (Html.BeginForm("ViewTeamMemberTimesheets", "Timesheets", FormMethod.Post))
{
    @if(Model.Projects != null && @Model.Projects.Count() != 0)
    {   
        <div class="d-flex align-items-center gap-3 mb-3">
            <label for="ProjectId" class="form-label mb-0" style="font-weight:bold">Select Project</label>

            @if (Model.Projects != null && Model.Projects.Any())
            {
                @Html.DropDownListFor(p => p.ProjectId,
                    new SelectList(Model.Projects, "ProjectId", "ProjectName"),
                    "-- Select Project --",
                    htmlAttributes: new { @class = "form-control", id = "ProjectId", style = "width: 400px;" })                
            }
            else
            {
                <span class="text-danger">No projects available. Please create a project first.</span>
            }
            @if (Model.Associates != null && Model.Associates.Any())
            {
                @Html.DropDownListFor(p => p.AssociateId,
                    new SelectList(Model.Associates, "AssociateId", "FullName"),
                    "-- Select Associate --",
                    htmlAttributes: new { @class = "form-control", id = "AssociateId", style = "width: 400px;" })                
            }
            @* else
            {
                <span class="text-danger">No Associates available. Please create an associate first.</span>
            } *@
            @if (Model.TimesheetPeriods != null && Model.TimesheetPeriods.Any())
            {
                @Html.DropDownListFor(p => p.TimesheetPeriodId,
                    new SelectList(Model.TimesheetPeriods, "TimesheetPeriodId", "WeekStartDate"),
                    "-- Select Timesheet Period --",
                    htmlAttributes: new { @class = "form-control", id = "TimesheetPeriodId", style = "width: 400px;" })
            }
            <button type="submit" class="btn btn-primary" id="btnLoadTeamMemberTimesheets"
                    style="width: 250px;" name="action" value="load">
                Load Team Member's Timesheets
            </button>
        </div>
        @* <span asp-validation-for="@Model.ProjectId" class="text-danger"></span>
        <span asp-validation-for="@Model.AssociateId" class="text-danger"></span> *@
    }
}
</section>

