<section>
<h2>Team Member's Timesheets</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Week</th>
            <th>Project</th>
            <th>Associate Name</th>
            <th>Hours Logged</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>        
        @if (Model.TimesheetsInfo!.Where(t => t.AssociateId != Model.CurrentAssociateId).Any() == false)
        {
            <tr>
                <td colspan="5" style="text-align: center; vertical-align: middle;">No team timesheets available.</td>
            </tr>
        }
        else
        {
            @foreach (var ts in Model.TimesheetsInfo!.Where(t => t.AssociateId != Model.CurrentAssociateId))
            {
                <tr>
                    <td style="text-align: center; vertical-align: middle;">@ts.TimesheetStartDate.ToShortDateString() - @ts.TimesheetEndDate.ToShortDateString()</td>
                    <td style="text-align: center; vertical-align: middle;">@ts.ProjectName</td> <!-- Replace with project name if available -->
                    <td style="text-align: center; vertical-align: middle;">@ts.AssociateName</td>
                    <td style="text-align: center; vertical-align: middle;">@ts.TotalHours</td>
                    <td style="text-align: center; vertical-align: middle;">@ts.TimesheetStatus</td>
                    <td style="text-align: center;">
                        @{
                            @* var status = @Model.TimesheetsInfo![0].TimesheetStatus;
                            var timesheetId = @Model.TimesheetsInfo![0].TimesheetId; *@
                            var origin = "ViewTeamMemberTimesheets";
                        }
                        @if (ts.TimesheetStatus != "Rejected")
                        {
                            <a asp-action="ViewTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@ts.TimesheetId" asp-route-tsperiodId="@Model.TimesheetPeriodId" class="btn btn-info btn-sm">View</a>
                        }
                        @if (ts.TimesheetStatus == "Submitted" || ts.TimesheetStatus == "Rejected")
                        {
                            <a asp-action="EditTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@ts.TimesheetId" class="btn btn-warning btn-sm">Edit</a>                            
                        }
                        @if (ts.TimesheetStatus == "Submitted")
                        {
                            <a asp-action="ApproveTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@ts.TimesheetId" asp-route-origin="@origin" class="btn btn-warning btn-sm">Approve</a>
                            <a asp-action="RejectTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@ts.TimesheetId" asp-route-origin="@origin" class="btn btn-danger btn-sm"
                                onclick="return confirm('Are you sure you want to reject this Timesheet?');">Reject</a>
                        }                        
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</section>