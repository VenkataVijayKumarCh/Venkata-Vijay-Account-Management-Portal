<div>
    <div>
        <dl class="row">
            @* <dt class="col-sm-2">Account Name</dt>
            <dd class="col-sm-10">@Model.AccountName</dd> *@
            <dt class="col-sm-2">Account Name</dt>
            <dd class="col-sm-10">@Model.TimesheetsInfo![0].AssociateName</dd>
            <dt class="col-sm-2">Project Name</dt>
            <dd class="col-sm-10">@Model.TimesheetsInfo![0].ProjectName</dd>                
            <dt class="col-sm-2">Start Date</dt>
            <dd class="col-sm-10">@Model.TimesheetsInfo![0].TimesheetStartDate.ToShortDateString()</dd>
            <dt class="col-sm-2">End Date</dt>
            <dd class="col-sm-10">@Model.TimesheetsInfo![0].TimesheetEndDate.ToShortDateString()</dd>                    
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">
                <b>@Model.TimesheetsInfo![0].TimesheetStatus</b>
            </dd>                
        </dl>
    </div>
    <div>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th></th>
                    @for (int index = 0; index < Model.TimesheetLineItems!.Count; index++)
                    {
                        <th>
                            @Model.TimesheetLineItems[index].WorkDate.DayOfWeek.ToString()
                        </th>
                    }
                    <th>Total Hours</th>
                </tr>
                <tr>
                    <th>Billability</th>
                    @for (int index = 0; index < Model.TimesheetLineItems!.Count; index++)
                    {
                        
                        <th>
                            @Html.HiddenFor(m => m.TimesheetLineItems![index].WorkDate)
                            @Model.TimesheetLineItems[index].WorkDate.ToShortDateString()
                        </th>
                    }
                    <th>Total Hours</th>
                </tr>
            </thead>
            <tbody>            
                <tr>
                    <td style="text-align:center;">
                        @billabilityText
                    </td>
                    @for (int index = 0; index < Model.TimesheetLineItems!.Count; index++)
                    {
                        @Html.HiddenFor(m => m.TimesheetLineItems![index].WorkDate)
                        var dayCode = Model.TimesheetLineItems[index].DayCode;
                        var statusClass = dayCode switch
                        {
                            "H" => "timesheet-status-holiday",
                            "L" => "timesheet-status-leave",
                            "W" => "timesheet-status-weekend",
                            _ => string.Empty
                        };
                        <td class="timesheet-status-cell @statusClass">
                            @if (!string.IsNullOrEmpty(dayCode) &&
                                (dayCode == "L" || dayCode == "H" || dayCode == "W"))
                            {
                                @dayCode
                            }
                            else
                            {
                                @Model.TimesheetLineItems[index].HoursWorked
                            }
                        </td>                    
                    }
                    <td style="text-align:center;">
                        @Model.TimesheetsInfo![0].TotalHours
                    </td>
                </tr>
                <tr>
                    <td colspan="9">
                        <b>Description: </b>@Model.TimesheetLineItems![0].Description
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="form-group" style="padding:5px 0px 5px 0px;">
    @if (Model.TimesheetsInfo[0].TimesheetStatus == "Submitted")
    {
        <a asp-action="ApproveTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@Model.TimesheetsInfo[0].TimesheetId" class="btn btn-warning btn-sm">Approve</a>
        <a asp-action="RejectTimesheet" asp-controller="Timesheets" asp-route-timesheetId="@Model.TimesheetsInfo[0].TimesheetId" class="btn btn-danger btn-sm"
            onclick="return confirm('Are you sure you want to reject this Timesheet?');">Reject</a>
    }
    <a asp-action="ViewMyTimesheets" asp-controller="Timesheets" class="btn btn-secondary">Cancel</a>
</div>
<fieldset>
    <legend style="font-size:18px;color:#8d71f1;font-weight:bold;">Important Notes:</legend>
    <div class="info" style="padding:5px 0px 5px 0px;">
        @* <p> *@
            @* <strong>Notes:</strong>  *@
            <ul>
                <li>Timesheet can be approved or rejected only when the status is <strong>Submitted</strong>.</li>
                <li>Once a Timesheet is approved or rejected, it cannot be modified.</li>
                <li>Based on the Holiday configuration in the system, all the corresponding week days will be marked as <strong>'H'</strong> accordingly unless associate has explicitly work log hours.</li>
                <li>Based on the Leaves applied in the system, all the corresponding week days will be marked as <strong>'L'</strong> accordingly unless associate has explicitly work log hours.</li>
                <li>Based on the Calendar, all the corresponding weekends will be marked as <strong>'W'</strong> accordingly unless associate has explicitly work log hours.</li>
            </ul>
        @* </p> *@
    </div>
</fieldset>