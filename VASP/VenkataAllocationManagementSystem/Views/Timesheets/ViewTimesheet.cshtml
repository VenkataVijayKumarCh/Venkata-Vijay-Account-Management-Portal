@model VenkataAllocationManagementSystem.ViewModels.TimesheetsViewModel
@using System.ComponentModel.DataAnnotations

@{
    ViewBag.Title = "View a Timesheet";

    var billabilityTypeId = Model.TimesheetsInfo![0].BillabilityTypeId;
    var billabilityText = "Unknown";
    if (billabilityTypeId.HasValue && Enum.IsDefined(typeof(VenkataAllocationManagementSystem.Models.BillabilityTypesEnum), billabilityTypeId.Value))
    {
        var billabilityType = (VenkataAllocationManagementSystem.Models.BillabilityTypesEnum)billabilityTypeId.Value;
        var enumMember = billabilityType.GetType().GetField(billabilityType.ToString());
        billabilityText = enumMember?.GetCustomAttributes(typeof(DisplayAttribute), false)
            .Cast<DisplayAttribute>()
            .FirstOrDefault()?.GetName() ?? billabilityType.ToString();
    }
}
<section>
    <p>This screen provides a summary of Timesheet for quick glance.</p>
</section>

