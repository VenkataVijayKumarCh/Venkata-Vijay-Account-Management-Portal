@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @* <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script> *@
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

    <script>
        Chart.register(ChartDataLabels);
        const projLabels = @Html.Raw(JsonSerializer.Serialize(Model.ProjectAllocations.Select(p=>p.ProjectName)));
        const projData = @Html.Raw(JsonSerializer.Serialize(Model.ProjectAllocations.Select(p=>p.AllocatedHours)));

        const ctx = document.getElementById('projectAllocChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: projLabels,
                datasets: [{
                    label: 'Allocated Hours',
                    data: projData,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)'
                }]
            },
            options: { responsive: true, 
                plugins: {
                    @* legend: {
                        position: 'right' 
                    }, *@
                    datalabels: {
                        anchor: 'center',
                        align: 'bottom',
                        formatter: Math.round,
                        font: {
                            weight: 'bold'
                        }
                    }
                },
            maintainAspectRatio: false}
        });

        const statusLabels = @Html.Raw(JsonSerializer.Serialize(Model.SubmissionStatuses.Select(s => s.Status)));
        const statusData = @Html.Raw(JsonSerializer.Serialize(Model.SubmissionStatuses.Select(s => s.Count)));

        const ctx2 = document.getElementById('submissionPie').getContext('2d');
        new Chart(ctx2, {
            type: 'pie',
            data: {
                labels: statusLabels,
                datasets: [{ data: statusData, backgroundColor: ['#36a2eb','#ff6384','#ffcd56','#4bc0c0'] }]
            },
            options: {
                responsive: true,
                plugins: {
                    @* legend: {
                        position: 'right' 
                    }, *@
                    datalabels: {
                        anchor: 'center',
                        align: 'bottom',
                        formatter: Math.round,
                        font: {
                            weight: 'bold'
                        }
                    }
                },
                maintainAspectRatio: false                
            }
        });
    </script>

    <script>
        Chart.register(ChartDataLabels);
        const labelsProjectName = @Html.Raw(JsonSerializer.Serialize(Model.TimesheetCompliance.Select(m => m.ProjectName)));
        const labelsWeekStartDate = @Html.Raw(JsonSerializer.Serialize(Model.TimesheetCompliance.Select(m => m.WeekStartDate)));
        const submitted = @Html.Raw(JsonSerializer.Serialize(Model.TimesheetCompliance.Select(m => m.Submitted)));
        const approved = @Html.Raw(JsonSerializer.Serialize(Model.TimesheetCompliance.Select(m => m.Approved)));
        const rejected = @Html.Raw(JsonSerializer.Serialize(Model.TimesheetCompliance.Select(m => m.Rejected)));
        const notSubmitted = @Html.Raw(JsonSerializer.Serialize(Model.TimesheetCompliance.Select(m => m.NotSubmitted)));

        // Combine into objects for easier filtering
        const rawData = [
            { label: 'Submitted', data: submitted, backgroundColor: '#4e73df' },
            { label: 'Approved', data: approved, backgroundColor: '#1cc88a' },
            { label: 'Rejected', data: rejected, backgroundColor: '#e74a3b' },
            { label: 'Not Submitted', data: notSubmitted, backgroundColor: '#f6c23e' }
        ];

        // Filter out datasets where all values are zero
        const filteredDatasets = rawData.filter(ds => ds.data.some(v => v !== "0" && v !== 0));

        new Chart(document.getElementById('complianceChart'), {
            type: 'bar',
            data: {
                @* labels: labelsProjectName.map((project, index) => `${project} - ${labelsWeekStartDate[index]}`), *@
                labels: labelsWeekStartDate,
                @* datasets: [
                    { label: 'Submitted', data: submitted, backgroundColor: '#4e73df' },
                    { label: 'Approved', data: approved, backgroundColor: '#1cc88a' },
                    { label: 'Rejected', data: rejected, backgroundColor: '#e74a3b' },
                    { label: 'Not Submitted', data: notSubmitted, backgroundColor: '#f6c23e' }
                ] *@
                datasets: filteredDatasets
            },
            options: {
                responsive: true,
                plugins: {
                    @* title: { display: true, text: 'Timesheet Compliance per Project' }, *@
                    legend: {
                        position: 'bottom' 
                    },
                    datalabels: {
                        anchor: 'center',
                        align: 'bottom',
                        formatter: Math.round,
                        font: {
                            weight: 'bold'
                        }
                    }
                },
                scales: {
                    x: { stacked: false },
                    y: { beginAtZero: true }
                }
            }
        });
    </script>

}