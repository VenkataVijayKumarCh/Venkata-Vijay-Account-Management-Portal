@using (Html.BeginForm("PortfolioDashboard", "Portfolio", FormMethod.Post))
{
    @if(Model.Projects != null && @Model.Projects.Count() != 0)
    {   
        <div class="d-flex align-items-center gap-3 mb-3">
            <label for="ProjectId" class="form-label mb-0" style="font-weight:bold">Select Project</label>

            @if (Model.Projects != null && Model.Projects.Any())
            {
                @Html.DropDownListFor(p => p.ProjectId,
                    new SelectList(Model.Projects, "ProjectId", "ProjectName"),
                    "-- Select Project --",
                    htmlAttributes: new { @class = "form-control", id = "ProjectId", style = "width: 400px;" })

                <button type="submit" class="btn btn-primary" id="btnLoadProjectPortfolioDashboard"
                        style="width: 250px;" name="action" value="load">
                    Load Portfolio Dashboards
                </button>
            }
            else
            {
                <span class="text-danger">No projects available. Please create a project first.</span>
            }
        </div>

        <span asp-validation-for="@Model.ProjectId" class="text-danger"></span>


