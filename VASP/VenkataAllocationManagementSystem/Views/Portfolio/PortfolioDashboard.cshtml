            <div class="card p-2">
            <h6 class="text-center mb-2">Timesheet Compliance Report - Project & TS Reporting Period</h6>
                <div style="width: 100%; max-width: 100%; height:450px;">
                    <canvas id="complianceChart"></canvas>
