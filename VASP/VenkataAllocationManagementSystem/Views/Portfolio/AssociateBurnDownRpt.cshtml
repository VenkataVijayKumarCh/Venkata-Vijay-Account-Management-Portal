@using VenkataAllocationManagementSystem.ViewModels
@model VenkataAllocationManagementSystem.ViewModels.PortfolioDashboardViewModel

@using (Html.BeginForm("AssociateBurnDownRpt", "Portfolio", FormMethod.Post))
{
    @if(Model.Projects != null && @Model.Projects.Count() != 0)
    {   
        <div class="d-flex align-items-center gap-3 mb-3">
            <label for="ProjectId" class="form-label mb-0" style="font-weight:bold">Select Project</label>

            @if (Model.Projects != null && Model.Projects.Any())
            {
                @Html.DropDownListFor(p => p.ProjectId,
                    new SelectList(Model.Projects, "ProjectId", "ProjectName"),
                    "-- Select Project --",
                    htmlAttributes: new { @class = "form-control", id = "ProjectId", style = "width: 400px;" })
                <span asp-validation-for="@Model.ProjectId" class="text-danger"></span>              
            }
            else
            {
                <span class="text-danger">No projects available. Please create a project first.</span>
            }
            @if (Model.Associates != null && Model.Associates.Any())
            {
                @Html.DropDownListFor(p => p.AssociateId,
                    new SelectList(Model.Associates, "AssociateId", "FullName"),
                    "-- Select Associate --",
                    htmlAttributes: new { @class = "form-control", id = "AssociateId", style = "width: 400px;" })                
            }
            @* else
            {
                <span class="text-danger">No Associates available. Please create an associate first.</span>
            } *@
            <button type="submit" class="btn btn-primary" id="btnLoadAssociateBurnDown"
                    style="width: 250px;" name="action" value="load">
                Load Portfolio Dashboards
            </button>            
            <a href="javascript:void(0);" id="exportAssociateBurndown" class="form-action" title="Export to Excel" aria-label="Export Associate Burndown to Excel">
                <img src="~/images/excel.jpg" alt="Excel Icon" title="Export to Excel" style="width:25px; height:25px; margin-right:5px;" class="fa-solid fa-file-excel"/>
            </a>

            <script>
                (function(){
                    var btn = document.getElementById('exportAssociateBurndown');
                    if (!btn) return;
                    btn.addEventListener('click', function(e){
                        e.preventDefault();
                        var projEl = document.getElementById('ProjectId');
                        var assocEl = document.getElementById('AssociateId');
                        var projectId = projEl ? projEl.value : '';
                        var associateId = assocEl ? assocEl.value : '';
                        if (!projectId && !associateId) {
                            alert('Please select at least one Project or Associate before exporting.');
                            return;
                        }
                        var url = '@Url.Action("ExportAssociateBurndowtoCSV","Portfolio")' + '?projectId=' + encodeURIComponent(projectId) + '&associateId=' + encodeURIComponent(associateId);
                        window.open(url, '_blank');
                    });
                })();
            </script>
        </div>
        @* <span asp-validation-for="@Model.ProjectId" class="text-danger"></span>
        <span asp-validation-for="@Model.AssociateId" class="text-danger"></span> *@
    }

    @if(Model.BurndownData != null && Model.BurndownData.Count() > 0)
    {
        <div>
            <dl class="row">
                @* <dt class="col-sm-2">Account Name</dt>
                <dd class="col-sm-10">@Model.AccountName</dd> *@
                <dt class="col-sm-2">Project Name</dt>
                <dd class="col-sm-10">@Model.BurndownData[0].Project!.ProjectName</dd>                    
                <dt class="col-sm-2">Start Date</dt>
                <dd class="col-sm-10">@Model.BurndownData[0].Project!.StartDate.ToShortDateString()</dd>
                <dt class="col-sm-2">End Date</dt>
                <dd class="col-sm-10">@Model.BurndownData[0].Project!.EndDate.ToShortDateString()</dd>                    
                <dt class="col-sm-2">Status</dt>
                <dd class="col-sm-10">
                    @if (@Model.BurndownData[0].Project!.IsActive)
                    {
                        <span class="badge bg-success">Active</span>                       
                    }
                    else if (@Model.BurndownData[0].Project!.IsActive = false && @Model.BurndownData[0].Project!.EndDate > DateOnly.FromDateTime(DateTime.Today))
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>                
            </dl>
        </div>
        <div>
            <table class="table">
                <thead>
                    <tr>
                        @* <th>Allocation ID</th> *@
                        <th>Associate Name</th>
                        @foreach (var tsp in @Model.TimesheetPeriods!)
                        {
                            <th>@tsp.WeekStartDate.ToString("MM/dd")</th>
                        }
                        <th>Total Hours</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (BurndownDataDto ts in @Model.BurndownData)
                    {
                        <tr>
                            <td >@ts.Associate!.FullName</td>
                            @foreach (var timesheet in ts.Timesheets!)
                            {
                                @* <td style="text-align:center;">@timesheet.TotalHours</td> *@
                                 <td style="text-align:center;"> @(ts.StartDate < Model.BurndownData[0].Project!.StartDate ? 0 : timesheet.TotalHours) </td>
                            }                            
                            <td style="text-align:center;">
                                @Model.BurndownData.Where(assoc => assoc.Associate!.AssociateId == ts.Associate!.AssociateId).Sum(x => x.Timesheets!.Sum(ts => ts.TotalHours))
                            </td>
                        </tr>
                    }
                    <tr>
                        <td style="font-weight:bold;">Total Hours</td>
                        @foreach (var tsp in @Model.TimesheetPeriods!)
                        {
                            <td style="text-align:center; font-weight:bold;">
                                @Model.BurndownData.Sum(x => x.Timesheets!.Where(ts => ts.TimesheetPeriodId == tsp.TimesheetPeriodId).Sum(ts => ts.TotalHours))
                            </td>
                        }
                        <td style="text-align:center; font-weight:bold;">
                            @Model.BurndownData.Sum(x => x.Timesheets!.Sum(ts => ts.TotalHours))
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
}