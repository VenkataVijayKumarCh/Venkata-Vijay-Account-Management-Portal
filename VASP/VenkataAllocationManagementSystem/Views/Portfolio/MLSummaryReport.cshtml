@model VenkataAllocationManagementSystem.ViewModels.MLSummaryReportViewModel

<h2>ML Summary Report</h2>

<div class="container-fluid">
    <!-- Section 1: No of Accounts and Projects -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">1) Accounts & Projects Overview</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-primary">@Model.TotalAccounts</h3>
                                    <p class="mb-0">Total Accounts</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-success">@Model.TotalProjects</h3>
                                    <p class="mb-0">Total Projects</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h3 class="text-info">@(Model.TotalAccounts > 0 ? (decimal)Model.TotalProjects / Model.TotalAccounts : 0):1</h3>
                                    <p class="mb-0">Avg Projects per Account</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    @if(Model.AccountProjectCounts.Any())
                    {
                        <div class="mt-4">
                            <h6>Projects by Account</h6>
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Account Name</th>
                                        <th class="text-end">Project Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var item in Model.AccountProjectCounts)
                                    {
                                        <tr>
                                            <td>@item.AccountName</td>
                                            <td class="text-end">@item.ProjectCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Section 2: Summary on Timesheets Status -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">2) Timesheets Status Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body text-center">
                                    <h4>@Model.TotalTimesheets</h4>
                                    <p class="mb-0">Total Timesheets</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning">
                                <div class="card-body text-center">
                                    <h4>@Model.SubmittedCount</h4>
                                    <p class="mb-0">Submitted</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <h4>@Model.ApprovedCount</h4>
                                    <p class="mb-0">Approved</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-danger text-white">
                                <div class="card-body text-center">
                                    <h4>@Model.RejectedCount</h4>
                                    <p class="mb-0">Rejected</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    @if(Model.TimesheetStatusSummary.Any())
                    {
                        <div class="mt-4">
                            <h6>Timesheet Status Distribution</h6>
                            <table class="table table-bordered">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>Status</th>
                                        <th class="text-end">Count</th>
                                        <th class="text-end">Percentage</th>
                                        <th>Distribution</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var item in Model.TimesheetStatusSummary)
                                    {
                                        <tr>
                                            <td><strong>@item.Status</strong></td>
                                            <td class="text-end">@item.Count</td>
                                            <td class="text-end">@item.Percentage.ToString("F2")%</td>
                                            <td>
                                                <div class="progress" style="height: 20px;">
                                                    <div class="progress-bar @(item.Status == "Approved" ? "bg-success" : item.Status == "Submitted" ? "bg-warning" : item.Status == "Rejected" ? "bg-danger" : "bg-secondary")" 
                                                         role="progressbar" 
                                                         style="width: @item.Percentage%;" 
                                                         aria-valuenow="@item.Percentage" 
                                                         aria-valuemin="0" 
                                                         aria-valuemax="100">
                                                        @item.Percentage.ToString("F1")%
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Section 3: Revenue Quick Summary by Month -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">3) Revenue Quick Summary (Monthly)</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="alert alert-primary">
                                <strong>Total Revenue (Last 12 Months):</strong> @Model.TotalRevenue.ToString("C2")
                            </div>
                        </div>
                    </div>
                    
                    @if(Model.MonthlyRevenues.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Year</th>
                                        <th>Month</th>
                                        <th class="text-end">Revenue</th>
                                        <th>Trend</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var prevRevenue = 0m;
                                    }
                                    @foreach(var item in Model.MonthlyRevenues)
                                    {
                                        <tr>
                                            <td>@item.Year</td>
                                            <td>@item.MonthName</td>
                                            <td class="text-end">@item.Revenue.ToString("C2")</td>
                                            <td>
                                                @if(prevRevenue > 0)
                                                {
                                                    var change = ((item.Revenue - prevRevenue) / prevRevenue) * 100;
                                                    @if(change > 0)
                                                    {
                                                        <span class="text-success">▲ @change.ToString("F1")%</span>
                                                    }
                                                    else if(change < 0)
                                                    {
                                                        <span class="text-danger">▼ @Math.Abs(change).ToString("F1")%</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">- 0%</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                        prevRevenue = item.Revenue;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">No revenue data available.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Section 4: Revenue Prediction vs Actual with Variance -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">4) Revenue Prediction vs Actual with Variance</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h5>@Model.TotalPredictedRevenue.ToString("C2")</h5>
                                    <p class="mb-0">Total Predicted Revenue</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <h5>@Model.TotalActualRevenue.ToString("C2")</h5>
                                    <p class="mb-0">Total Actual Revenue</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card @(Model.TotalVariance >= 0 ? "bg-success" : "bg-danger") text-white">
                                <div class="card-body text-center">
                                    <h5>@Model.TotalVariance.ToString("C2")</h5>
                                    <p class="mb-0">Total Variance @(Model.TotalVariance >= 0 ? "(Favorable)" : "(Unfavorable)")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    @if(Model.RevenuePredictions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Year</th>
                                        <th>Month</th>
                                        <th class="text-end">Predicted Revenue</th>
                                        <th class="text-end">Actual Revenue</th>
                                        <th class="text-end">Variance</th>
                                        <th class="text-end">Variance %</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var item in Model.RevenuePredictions)
                                    {
                                        <tr>
                                            <td>@item.Year</td>
                                            <td>@item.MonthName</td>
                                            <td class="text-end">@item.PredictedRevenue.ToString("C2")</td>
                                            <td class="text-end">@item.ActualRevenue.ToString("C2")</td>
                                            <td class="text-end @(item.Variance >= 0 ? "text-success" : "text-danger")">
                                                @(item.Variance >= 0 ? "+" : "")@item.Variance.ToString("C2")
                                            </td>
                                            <td class="text-end @(item.VariancePercentage >= 0 ? "text-success" : "text-danger")">
                                                @(item.VariancePercentage >= 0 ? "+" : "")@item.VariancePercentage.ToString("F2")%
                                            </td>
                                            <td>
                                                @if(item.VariancePercentage >= 5)
                                                {
                                                    <span class="badge bg-success">Exceeding</span>
                                                }
                                                else if(item.VariancePercentage >= -5 && item.VariancePercentage < 5)
                                                {
                                                    <span class="badge bg-warning text-dark">On Track</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Below Target</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">No prediction data available.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Section 5: Financial Metrics -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">5) Financial Metrics</h5>
                </div>
                <div class="card-body">
                    <!-- Revenue per Project -->
                    <div class="mb-5">
                        <h6 class="text-primary fw-bold">Revenue per Project</h6>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="alert alert-info">
                                    <strong>Total Project Revenue:</strong> @Model.FinancialMetrics.TotalProjectRevenue.ToString("C2")
                                </div>
                            </div>
                        </div>
                        @if(Model.FinancialMetrics.RevenuePerProject.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>Project Name</th>
                                            <th>Account</th>
                                            <th class="text-end">Revenue</th>
                                            <th class="text-end">% of Total</th>
                                            <th>Distribution</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach(var item in Model.FinancialMetrics.RevenuePerProject)
                                        {
                                            <tr>
                                                <td>@item.ProjectName</td>
                                                <td>@item.AccountName</td>
                                                <td class="text-end">@item.Revenue.ToString("C2")</td>
                                                <td class="text-end">@item.PercentageOfTotal.ToString("F2")%</td>
                                                <td>
                                                    <div class="progress" style="height: 20px;">
                                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @item.PercentageOfTotal%;" aria-valuenow="@item.PercentageOfTotal" aria-valuemin="0" aria-valuemax="100">
                                                            @item.PercentageOfTotal.ToString("F1")%
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">No project revenue data available.</div>
                        }
                    </div>

                    <!-- Revenue per Associate -->
                    <div class="mb-5">
                        <h6 class="text-success fw-bold">Revenue per Associate</h6>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="alert alert-success">
                                    <strong>Total Associate Revenue:</strong> @Model.FinancialMetrics.TotalAssociateRevenue.ToString("C2")
                                </div>
                            </div>
                        </div>
                        @if(Model.FinancialMetrics.RevenuePerAssociate.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-success">
                                        <tr>
                                            <th>Associate Name</th>
                                            <th>Employee ID</th>
                                            <th class="text-end">Revenue</th>
                                            <th class="text-end">% of Total</th>
                                            <th>Distribution</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach(var item in Model.FinancialMetrics.RevenuePerAssociate)
                                        {
                                            <tr>
                                                <td>@item.AssociateName</td>
                                                <td>@item.EmployeeId</td>
                                                <td class="text-end">@item.Revenue.ToString("C2")</td>
                                                <td class="text-end">@item.PercentageOfTotal.ToString("F2")%</td>
                                                <td>
                                                    <div class="progress" style="height: 20px;">
                                                        <div class="progress-bar bg-success" role="progressbar" style="width: @item.PercentageOfTotal%;" aria-valuenow="@item.PercentageOfTotal" aria-valuemin="0" aria-valuemax="100">
                                                            @item.PercentageOfTotal.ToString("F1")%
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">No associate revenue data available.</div>
                        }
                    </div>

                    <!-- Cost Variance -->
                    <div class="mb-5">
                        <h6 class="text-warning fw-bold">Cost Variance (Budget vs Actual)</h6>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <div class="card bg-secondary text-white">
                                    <div class="card-body text-center">
                                        <h5>@Model.FinancialMetrics.TotalBudgetedCost.ToString("C2")</h5>
                                        <p class="mb-0">Total Budgeted Cost</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-info text-white">
                                    <div class="card-body text-center">
                                        <h5>@Model.FinancialMetrics.TotalActualCost.ToString("C2")</h5>
                                        <p class="mb-0">Total Actual Cost</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card @(Model.FinancialMetrics.TotalCostVariance >= 0 ? "bg-success" : "bg-danger") text-white">
                                    <div class="card-body text-center">
                                        <h5>@Model.FinancialMetrics.TotalCostVariance.ToString("C2")</h5>
                                        <p class="mb-0">Total Variance @(Model.FinancialMetrics.TotalCostVariance >= 0 ? "(Under)" : "(Over)")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if(Model.FinancialMetrics.CostVariances.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead class="table-warning">
                                        <tr>
                                            <th>Project Name</th>
                                            <th class="text-end">Budgeted Cost</th>
                                            <th class="text-end">Actual Cost</th>
                                            <th class="text-end">Variance</th>
                                            <th class="text-end">Variance %</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach(var item in Model.FinancialMetrics.CostVariances)
                                        {
                                            <tr>
                                                <td>@item.ProjectName</td>
                                                <td class="text-end">@item.BudgetedCost.ToString("C2")</td>
                                                <td class="text-end">@item.ActualCost.ToString("C2")</td>
                                                <td class="text-end @(item.Variance >= 0 ? "text-success" : "text-danger")">
                                                    @(item.Variance >= 0 ? "+" : "")@item.Variance.ToString("C2")
                                                </td>
                                                <td class="text-end @(item.VariancePercentage >= 0 ? "text-success" : "text-danger")">
                                                    @(item.VariancePercentage >= 0 ? "+" : "")@item.VariancePercentage.ToString("F2")%
                                                </td>
                                                <td>
                                                    @if(item.Status == "Under Budget")
                                                    {
                                                        <span class="badge bg-success">Under Budget</span>
                                                    }
                                                    else if(item.Status == "Over Budget")
                                                    {
                                                        <span class="badge bg-danger">Over Budget</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">No Budget</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">No cost variance data available.</div>
                        }
                    </div>

                    <!-- Profit Margin -->
                    <div class="mb-3">
                        <h6 class="text-danger fw-bold">Profit Margin</h6>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <div class="card bg-primary text-white">
                                    <div class="card-body text-center">
                                        <h5>@Model.FinancialMetrics.TotalRevenue.ToString("C2")</h5>
                                        <p class="mb-0">Total Revenue</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-secondary text-white">
                                    <div class="card-body text-center">
                                        <h5>@Model.FinancialMetrics.TotalCost.ToString("C2")</h5>
                                        <p class="mb-0">Total Cost</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-danger text-white">
                                    <div class="card-body text-center">
                                        <h5>@Model.FinancialMetrics.OverallProfitMargin.ToString("C2")</h5>
                                        <p class="mb-0">Net Profit</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if(Model.FinancialMetrics.ProfitMargins.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead class="table-danger">
                                        <tr>
                                            <th>Project Name</th>
                                            <th class="text-end">Revenue</th>
                                            <th class="text-end">Cost</th>
                                            <th class="text-end">Profit Margin</th>
                                            <th class="text-end">Margin %</th>
                                            <th>Performance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach(var item in Model.FinancialMetrics.ProfitMargins)
                                        {
                                            <tr>
                                                <td>@item.ProjectName</td>
                                                <td class="text-end">@item.Revenue.ToString("C2")</td>
                                                <td class="text-end">@item.Cost.ToString("C2")</td>
                                                <td class="text-end @(item.ProfitMargin >= 0 ? "text-success" : "text-danger")">
                                                    @item.ProfitMargin.ToString("C2")
                                                </td>
                                                <td class="text-end @(item.ProfitMarginPercentage >= 0 ? "text-success" : "text-danger")">
                                                    @item.ProfitMarginPercentage.ToString("F2")%
                                                </td>
                                                <td>
                                                    @if(item.ProfitMarginPercentage >= 30)
                                                    {
                                                        <span class="badge bg-success">Excellent</span>
                                                    }
                                                    else if(item.ProfitMarginPercentage >= 15)
                                                    {
                                                        <span class="badge bg-info">Good</span>
                                                    }
                                                    else if(item.ProfitMarginPercentage >= 0)
                                                    {
                                                        <span class="badge bg-warning text-dark">Low</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Loss</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">No profit margin data available.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 6: Timesheet Compliance Report -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">6) Timesheet Compliance Report</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-2">
                            <div class="card bg-info text-white">
                                <div class="card-body text-center">
                                    <h5>@Model.TotalAllocatedAssociates</h5>
                                    <p class="mb-0">Total Associates</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-warning">
                                <div class="card-body text-center">
                                    <h5>@Model.TotalTimesheetComplianceSubmitted</h5>
                                    <p class="mb-0">Submitted</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <h5>@Model.TotalTimesheetComplianceApproved</h5>
                                    <p class="mb-0">Approved</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-danger text-white">
                                <div class="card-body text-center">
                                    <h5>@Model.TotalTimesheetComplianceRejected</h5>
                                    <p class="mb-0">Rejected</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card bg-dark">
                                <div class="card-body text-center">
                                    <h5>@Model.TotalTimesheetComplianceNotSubmitted</h5>
                                    <p class="mb-0">Not Submitted</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="card @(Model.ComplianceRate >= 80 ? "bg-success" : Model.ComplianceRate >= 50 ? "bg-warning" : "bg-danger") text-white">
                                <div class="card-body text-center">
                                    <h5>@Model.ComplianceRate.ToString("F1")%</h5>
                                    <p class="mb-0">Compliance Rate</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    @if(Model.TimesheetCompliance.Any())
                    {
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-hover">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>Period</th>
                                        <th class="text-end">Submitted</th>
                                        <th class="text-end">Approved</th>
                                        <th class="text-end">Rejected</th>
                                        <th class="text-end">Not Submitted</th>
                                        <th class="text-end">Total Expected</th>
                                        <th>Compliance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var item in Model.TimesheetCompliance)
                                    {
                                        var totalExpected = item.Submitted + item.Approved + item.Rejected + item.NotSubmitted;
                                        var periodCompliance = totalExpected > 0 ? (decimal)(item.Submitted + item.Approved) / totalExpected * 100 : 0;
                                        <tr>
                                            <td><strong>@item.WeekStartDate</strong></td>
                                            <td class="text-end">@item.Submitted</td>
                                            <td class="text-end">@item.Approved</td>
                                            <td class="text-end">@item.Rejected</td>
                                            <td class="text-end">@item.NotSubmitted</td>
                                            <td class="text-end">@totalExpected</td>
                                            <td>
                                                <div class="progress" style="height: 20px;">
                                                    <div class="progress-bar @(periodCompliance >= 80 ? "bg-success" : periodCompliance >= 50 ? "bg-warning" : "bg-danger")" 
                                                         role="progressbar" 
                                                         style="width: @periodCompliance%;" 
                                                         aria-valuenow="@periodCompliance" 
                                                         aria-valuemin="0" 
                                                         aria-valuemax="100">
                                                        @periodCompliance.ToString("F1")%
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="card mt-4">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Timesheet Defaulters</h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover mb-0">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Period</th>
                                                <th>Defaulting Associates</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach(var item in Model.TimesheetCompliance)
                                            {
                                                <tr>
                                                    <td><strong>@item.WeekStartDate</strong></td>
                                                    <td>
                                                        @if(!string.IsNullOrWhiteSpace(item.DefaulterNames))
                                                        {
                                                            <small>@item.DefaulterNames</small>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-success">None</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">No timesheet compliance data available.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>