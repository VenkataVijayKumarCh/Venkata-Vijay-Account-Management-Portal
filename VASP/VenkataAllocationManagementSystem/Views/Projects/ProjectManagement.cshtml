@* Create a view to display all Project Info or Single Project Info along with Account Name and Description. Also need Create Project button as well *@
@model VenkataAllocationManagementSystem.ViewModels.ProjectManagementViewModel

@{
    ViewData["Title"] = "Project Management";
}

@* <h2>@ViewData["Title"]</h2> *@
<section>
    <h2>Welcome to the Project Management Dashboard</h2>
    <p>This dashboard provides an overview of all the Projects of Softility.</p>
</section>
<p>
    <a class="btn btn-primary" asp-controller="Projects" asp-action="CreateProject">Create Project</a>
</p>
@if(@TempData["SuccessMessage"] != null)
    {
       <div class="alert alert-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }
@if (@Model.Projects != null && @Model.Projects.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
               <th style="text-align:center;">Account Name</th>
               <th style="text-align:center;">Project Name</th>       
               <th style="text-align:center;">Status</th>
               <th>Start Date</th>
               <th>End Date Date</th>
                @* <th style="text-align:center;">Account Description</th> *@
                <th style="text-align:center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in @Model.Projects)
            {
                <tr>
                    <td>@Model.AccountName</td>
                    <td>@project.ProjectName</td>
                    <td>
                        @if (@project.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>@project.StartDate</td>
                    <td>@project.EndDate</td>
                    
                    @* <td>@project.Account?.AccountName</td>
                    <td>@project.Account?.Description</td> *@
                    <td>
                        <a asp-action="ViewProject" asp-controller="Projects" asp-route-projectId="@project.ProjectId" class="btn btn-info btn-sm">View</a>
                        @if (@project.IsActive)
                        {
                            <a asp-action="EditProject" asp-controller="Projects" asp-route-projectId="@project.ProjectId" class="btn btn-warning btn-sm">Edit</a>
                        }
                        else
                        {
                            <a asp-action="EditProject" asp-controller="Projects" asp-route-projectId="@project.ProjectId" class="btn btn-secondary btn-sm disabled" aria-disabled="true" title="Cannot edit an inactive project">Edit</a>
                        }
                        <a asp-action="DeleteProject" asp-controller="Projects" asp-route-projectId="@project.ProjectId" class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this Project?');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No projects found.</div>
}

