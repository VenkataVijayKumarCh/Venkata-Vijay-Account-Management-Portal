@using VenkataAllocationManagementSystem.ViewModels

@{
    ViewData["Title"] = "Account Management Dashboard";
}

@* <h1>@ViewData["Title"]</h1> *@
<section>
    <h2>Welcome to the Account Management Dashboard</h2>
    <p>This dashboard provides an overview of all the Accounts of Softility.</p>
</section>

<section>
    <h2>Accounts</h2>
    <p>
        <a class="btn btn-primary" asp-controller="Accounts" asp-action="CreateAccount">Create New Account</a>
    </p>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (@Model.Accounts == null || @Model.Accounts.Count == 0)
            {
                <tr>
                    <td colspan="4">No accounts found.</td>
                </tr>
            }
            else
            {   
                @foreach (var account in @Model.Accounts)
                {
                    <tr>
                        @* <td>@account.AccountId</td> *@
                        <td>@account.AccountName</td>
                        <td>@account.Description</td>
                        <td>
                            @if(@account.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>                        
                        <td>
                            <a asp-controller="Accounts" asp-action="ViewAccount" asp-route-AccountId="@account.AccountId" class="btn btn-info btn-sm">View</a> 
                            <a asp-controller="Accounts" asp-action="EditAccount" asp-route-AccountId="@account.AccountId" class="btn btn-warning btn-sm">Edit</a>                          
                            <a asp-controller="Accounts" asp-action="DeleteAccount" asp-route-AccountId="@account.AccountId" class="btn btn-danger btn-sm"
                                onclick="return confirm('Are you sure you want to delete this account?');">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</section>