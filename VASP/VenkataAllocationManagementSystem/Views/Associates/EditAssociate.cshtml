@using (Html.BeginForm("UpdateAssociate", "Associates", FormMethod.Post))
{
    @* @if (Model.Associate != null && Model.Associate.AssociateId > 0)
    {
        @Html.HiddenFor(a => a.Associate.AssociateId)
    } *@
   <input type="hidden" asp-for="Associate.AssociateId" />
